{
  "name": "orbsky",
  "version": "0.1.0",
  "private": true,
  "description": "Twitch配信開始を検知してBlueskyのstreaming status(#live)に自動反映するCloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup-subscriptions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@atproto-labs/did-resolver": "^0.3.7",
    "@atproto-labs/simple-store-memory": "^0.2.6",
    "@atproto/did": "^0.5.4",
    "@atproto/jwk-webcrypto": "^0.3.4",
    "@atproto/oauth-client": "^0.8.3"
  }
}
