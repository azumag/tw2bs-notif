{
  "name": "orbsky",
  "version": "0.1.0",
  "private": true,
  "description": "Twitch配信開始を検知してBlueskyのstreaming status(#live)に自動反映するCloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
